# Frontend (Vite) — every VITE_ variable is PUBLIC and ships in the browser bundle.
# Never put a secret here. See docs/SECURITY.md.
VITE_API_URL=/api
VITE_WHATSAPP_NUMBER=
VITE_RAZORPAY_KEY_ID=
VITE_SENTRY_DSN=

# ── Backend: compliance declarations ──────────────────────────────────────
# These are legal declarations, not configuration. Invoicing refuses to run
# until they are set. See docs/COMPLIANCE.md.
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_STATE=Karnataka
SELLER_GSTIN=
FSSAI_LICENCE=
GRIEVANCE_OFFICER=
GRIEVANCE_EMAIL=
CONSUMER_CARE_PHONE=

# ── Frontend: the same values, displayed on the storefront ────────────────
# Public by design — they must be visible to customers.
VITE_SELLER_LEGAL_NAME=
VITE_SELLER_ADDRESS=
VITE_FSSAI_LICENCE=
VITE_GRIEVANCE_OFFICER=
VITE_GRIEVANCE_EMAIL=

# ── Admin subdomain ───────────────────────────────────────────────────────
# Origins allowed to call the API with credentials. Comma-separated, never '*'.
ADMIN_ORIGIN=http://localhost:5174
# Set in production so the session cookie spans subdomains, e.g.
# .svhomeproducts.com — leave unset locally, browsers reject it for localhost.
COOKIE_DOMAIN=
